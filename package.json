{
  "name": "samehadaku-anime-api",
  "version": "1.0.0",
  "description": "Production-ready anime REST API with PostgreSQL, Redis, Cheerio native scraper, BullMQ sync worker and OpenAPI Swagger",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev:api": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start": "node dist/index.js",
    "start:api": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "sync": "tsx src/scripts/sync-cli.ts",
    "posters:download": "tsx src/scripts/download-posters.ts",
    "posters:fix": "tsx src/scripts/fix-null-posters.ts",
    "cf:warmup": "tsx src/scripts/cf-warmup.ts",
    "cf:test": "tsx src/scripts/test-cf.ts",
    "cf:solve": "tsx src/scripts/solve-cf.ts",
    "redis:migrate": "tsx src/scripts/migrate-redis.ts",
    "redis:migrate:dry": "tsx src/scripts/migrate-redis.ts --dry-run",
    "redis:migrate:no-bull": "tsx src/scripts/migrate-redis.ts --skip-bull",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "anime",
    "api",
    "fastify",
    "scraper",
    "cheerio",
    "postgresql",
    "prisma",
    "redis",
    "bullmq"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^10.1.4",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "@prisma/client": "^6.4.1",
    "bullmq": "^5.41.6",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ioredis": "^5.5.0",
    "node-cron": "^3.0.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "playwright": "^1.63.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "undici": "^7.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/node-cron": "^3.0.11",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
