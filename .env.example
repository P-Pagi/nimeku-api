NODE_ENV=development
PORT=4000
HOST=0.0.0.0
SOURCE_BASE_URL=https://v2.samehadaku.how
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/samehadaku?schema=public
REDIS_URL=redis://localhost:6379
ADMIN_API_KEY=samehadaku-admin-secret-key-32chars

SCRAPER_MAX_CONCURRENCY=2
SCRAPER_MIN_DELAY_MS=1000
SCRAPER_TIMEOUT_MS=15000
SCRAPER_MAX_RETRIES=3
SOURCE_FAILURE_THRESHOLD=5
SOURCE_COOLDOWN_MINUTES=10

SYNC_RECENT=*/10 * * * *
SYNC_ONGOING=*/30 * * * *
SYNC_POPULAR=0 */6 * * *
SYNC_SCHEDULE=0 * * * *
SYNC_GENRES=0 3 * * *

ENABLE_PLAYWRIGHT_FALLBACK=false
FIRECRAWL_API_KEY=

# Set true to run background sync worker inside the API server process
EMBED_WORKER=true
